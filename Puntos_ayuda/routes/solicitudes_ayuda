const express = require('express');
const router = express.Router();
const { connection } = require('../config/config.db');

const postSolicitudAyuda = (req, res) => {
    const { punto_ayuda_id, usuario_id, tipo_ayuda, descripcion, contacto } = req.body;

    // Insertar en la base de datos
    connection.query(
        "INSERT INTO solicitudes_ayuda (punto_ayuda_id, usuario_id, tipo_ayuda, descripcion, contacto) VALUES (?, ?, ?, ?, ?)",
        [punto_ayuda_id, usuario_id, tipo_ayuda, descripcion, contacto],
        (err, result) => {
            if (err) {
                console.error("Error al registrar solicitud de ayuda:", err);
                return res.status(500).json({ mensaje: "Error interno del servidor" });
            }
            res.status(201).json({ mensaje: "Solicitud de ayuda registrada", id: result.insertId });
        }
    );
};

router.post('/solicitud/post', postSolicitudAyuda);
module.exports = router;